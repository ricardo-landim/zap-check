# zap-check configuration (copy to .env and fill in)
# Provider to use (only "uazapi" for now; add yours in src/providers/)
ZAPCHECK_PROVIDER=uazapi
# Your verification instance (a DISPOSABLE account: never your official sender)
ZAPCHECK_URL=https://your-subdomain.example-provider.com
ZAPCHECK_TOKEN=your-instance-token-here
# Tuning (optional)
ZAPCHECK_BATCH_SIZE=20
ZAPCHECK_INTERVAL_MS=1000
ZAPCHECK_CACHE_TTL_MS=0
# Server mode only (optional)
ZAPCHECK_PORT=8377
ZAPCHECK_ACCESS_TOKEN=
